{
  "name": "museboard",
  "version": "0.5.0",
  "description": "Local infinite canvas plugin for Codex image workflows, built from Codex-Canvas.",
  "type": "module",
  "homepage": "https://github.com/joelam-byte/museboard-next",
  "repository": {
    "type": "git",
    "url": "https://github.com/joelam-byte/museboard-next.git"
  },
  "bin": {
    "museboard": "./bin/museboard.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "AGENTS.md",
    "INSTALL.md",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "LICENSE",
    "assets/icon.png",
    "bin/",
    "public/app.js",
    "public/canvas-history.js",
    "public/icon.png",
    "public/index.html",
    "public/styles.css",
    "scripts/compose_annotations.py",
    "scripts/checkout-stable-release.mjs",
    "scripts/install-personal-plugin.mjs",
    "scripts/prepare_completed_background.py",
    "scripts/prepare_expand_canvas.py",
    "scripts/remove_chroma_key_connected.py",
    "scripts/split_elements.py",
    "scripts/verify_elements_layers.py",
    "skills/",
    "src/"
  ],
  "scripts": {
    "setup:ocr": "node ./bin/museboard.mjs setup-ocr",
    "setup:image-deps": "node ./bin/museboard.mjs setup-image-deps",
    "setup:deps": "node ./bin/museboard.mjs setup-deps",
    "checkout:stable": "node ./scripts/checkout-stable-release.mjs",
    "install:preview": "node ./scripts/install-personal-plugin.mjs",
    "install:personal": "node ./scripts/install-personal-plugin.mjs",
    "install:dev-cache": "node ./scripts/link-dev-plugin-cache.mjs",
    "doctor:ocr": "node ./bin/museboard.mjs doctor-ocr --json",
    "doctor:image-deps": "node ./bin/museboard.mjs doctor-image-deps --json",
    "doctor:deps": "node ./bin/museboard.mjs doctor-deps --json",
    "start": "node ./bin/museboard.mjs start",
    "validate": "node ./bin/museboard.mjs status --json",
    "smoke": "node ./scripts/smoke.mjs",
    "smoke:visual": "node ./scripts/visual-smoke.mjs",
    "visual:regression": "node ./scripts/visual-regression.mjs",
    "validate:contracts": "node ./scripts/validate-contracts.mjs",
    "verify:release": "node ./scripts/verify-release.mjs",
    "verify:archive": "node ./scripts/verify-release-archive.mjs",
    "build:release": "node ./scripts/build-release.mjs",
    "test": "node --test ./test/agent-runs.test.mjs ./test/agent-brief-service.test.mjs ./test/agent-run-api.test.mjs ./test/agent-analyzer.test.mjs ./test/agent-run-execution.test.mjs ./test/agent-job-provenance.test.mjs ./test/business-skill-recipes.test.mjs ./test/business-skill-ui.test.mjs ./test/history-assets.test.mjs ./test/task-canvas-persistence.test.mjs ./test/generate-image-agent-run.test.mjs && npm run smoke"
  },
  "keywords": [
    "codex",
    "museboard",
    "plugin",
    "canvas",
    "imagegen"
  ],
  "author": {
    "name": "Museboard Contributors"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "ag-psd": "^31.0.0",
    "cross-spawn": "^7.0.6",
    "pngjs": "^7.0.0"
  }
}
